function doPost(e){var b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}');if(b.action!=='sync')return json_({ok:false});PropertiesService.getScriptProperties().setProperty('watchlist',JSON.stringify(b.watchlist||{}));ensureTrigger_();return json_({ok:true});}
function doGet(){return json_({ok:true,service:'AKT-Pro background mail'});}
function ensureTrigger_(){var a=ScriptApp.getProjectTriggers();for(var i=0;i<a.length;i++)if(a[i].getHandlerFunction()==='checkAlerts')return;ScriptApp.newTrigger('checkAlerts').timeBased().everyMinutes(15).create();}
function checkAlerts(){var w=JSON.parse(PropertiesService.getScriptProperties().getProperty('watchlist')||'{}'),changed=false;Object.keys(w).forEach(function(k){var x=w[k];if(!x||!x.email||!x.symbol)return;try{var d=fetch_(x.symbol),p=d.price;if(p==null)return;var r=rec_(d.close);if(!x.lastRec){x.lastRec=r;x.lastPrice=p;changed=true;return;}var send=(r==='KAUFEN'&&x.buy!==false)||(r==='NICHT KAUFEN'&&x.sell!==false);if(send&&r!==x.lastRec)MailApp.sendEmail({to:x.email,subject:'AKT-Pro Alarm: '+r+' – '+x.symbol,htmlBody:'<b>AKT-Pro Alarm</b><br>'+x.symbol+' → '+r+'<br>Kurs: '+p});x.lastRec=r;x.lastPrice=p;changed=true;}catch(e){x.lastError=String(e);changed=true;}});if(changed)PropertiesService.getScriptProperties().setProperty('watchlist',JSON.stringify(w));}
function fetch_(s){var u='https://query1.finance.yahoo.com/v8/finance/chart/'+encodeURIComponent(s)+'?range=1y&interval=1d',r=UrlFetchApp.fetch(u,{muteHttpExceptions:true});if(r.getResponseCode()!=200)return{};var z=JSON.parse(r.getContentText()).chart.result[0],c=z.indicators.quote[0].close.filter(function(x){return typeof x==='number'});return{price:c.length?c[c.length-1]:null,close:c};}
function rec_(c){if(c.length<50)return'BEOBACHTEN';var n=c[c.length-1],a=c.slice(-20).reduce(function(x,y){return x+y},0)/20,b=c.slice(-50).reduce(function(x,y){return x+y},0)/50,s=50+(n>a?8:-8)+(n>b?10:-10);return s>=68?'KAUFEN':s<=42?'NICHT KAUFEN':'BEOBACHTEN';}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}